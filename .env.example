# ============================================================
# Example environment file. Copy to .env and adjust.
# scripts\setup-database.ps1 and scripts\start-backend.ps1 read it.
# Docker Compose reads the same names (see docker-compose.yml).
# ============================================================

# PostgreSQL superuser (used only by scripts\setup-database.ps1 to create the
# least-privilege application role).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# Application database (owned by the least-privilege role).
POSTGRES_DB=phishing_detection
POSTGRES_USER=phish_app
POSTGRES_PASSWORD=change_this_password

# Service endpoints (local development defaults).
AI_SERVICE_URL=http://localhost:8000
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/phishing_detection

# Optional: shared secret between Spring Boot and the Python service. When set,
# the AI service rejects /analyze/* calls without the matching X-AI-Service-Key.
# AI_SERVICE_API_KEY=

# Optional: dashboard build-time API base (defaults to http://localhost:8088/api;
# docker-compose builds it with /api, proxied by nginx).
# VITE_API_BASE_URL=/api
