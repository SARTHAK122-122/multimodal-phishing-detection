# AI service configuration (FastAPI)
# Overridable via environment variables.

# Directory that holds uploaded raw datasets and generated processed files.
# Must be the SAME directory the Spring Boot backend writes to.
UPLOAD_DIR=../uploads
PROCESSED_DIR=../uploads/processed

# Directory holding trained model artifacts (created by training scripts).
MODEL_DIR=../models

# Safety limits for webpage acquisition
MAX_FETCH_BYTES=2000000
MAX_REDIRECTS=3
FETCH_TIMEOUT_SECONDS=15

# Use the real Playwright renderer when available, otherwise report the
# modality as unavailable instead of faking it.
ENABLE_SCREENSHOTS=true
